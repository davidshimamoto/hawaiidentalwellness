# Copy this file to .env.local for local development (never commit .env.local).
# In Vercel, set these under Project Settings > Environment Variables instead.

# Required for the /api/appointment route to actually send emails.
# Get a key at https://resend.com after verifying the hawaiidentalwellness.com
# sending domain. Without this set, appointment submissions are validated but
# fail with a "call us" error instead of emailing anyone.
RESEND_API_KEY=
